  <widget class="QWidget" name="centralWidget">
   <property name="styleSheet">
    <string notr="true">*{
	color:#000;
	border:none;
}
QPushButton{
	padding: 9px 5px;
	text-align: left;
}
#headerLabel{
	color: #ffffff;
}
#sidebarWidget{
	background-color: #65132d;
}
#accueilBtn{
	background-color:#e5e5e5;
	padding: 10px 5px;
	text-align: left;
	border-top-left-radius: 15px;
}
#reglagesBtn, #renommageBtn, #sauvegardeBtn{
	color: #ffffff;
}
#statusHLine{
	background-color: #ffffff;
	max-height: 1px;
}
#camStoStatusLabel, #extStoStatusLabel{
	color: #ffffff;
	font-weight: bold;
}
#bodyWidget{
	background-color: #e5e5e5;
}
#card1, #card2, #card3{
	background-color:#ffffff;
	border-radius:17px;
}
#separationBtn, #coherenceBtn, #rangementBtn, #suppressionBtn{
	background-color: white;
	color: black;
	border-radius: 10px;
	text-align: center;
}
#separationBtn:pressed, #coherenceBtn:pressed, #rangementBtn:pressed, #suppressionBtn:pressed{
	background-color: #5a0022;
	color: white;
	text-align: center;
}
#separationBtn:disabled, #coherenceBtn:disabled, #rangementBtn:disabled, #suppressionBtn:disabled{
	color: #e5e5e5;
}
#settingsWidget{
	background-color:#ffffff;
	border-radius:10px;
}
#progressBar{
	background-color: #e5e5e5;
}
#eventNameLine, #nPicLine, #dateEdit{
	border: 1px solid #e5e5e5;
	border-radius: 4px;
}
#okBtn, #cancelBtn{
	border: 1px solid black;
	border-radius: 4px;
	text-align: center;
	padding: 4px;
}
#okBtn:disabled, #cancelBtn:disabled{
	border: 1px solid #e5e5e5;
	color: #e5e5e5;
}
#okBtn:pressed, #cancelBtn:pressed{
	border: 1px solid  #65132d;
	background-color: #65132d;
	color: white;
}</string>
